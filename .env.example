# Copia este archivo como .env.local y completa los valores (no se sube a git).

# Google Maps (opcional). Con clave, el buscador de estaciones usa Google Maps como en Copec.
# Crea la clave en https://console.cloud.google.com/google/maps-apis (habilita "Maps JavaScript API")
# y restríngela a tus dominios (HTTP referrers).
VITE_GOOGLE_MAPS_API_KEY=

# Map ID para marcadores personalizados (Map Management > Create Map ID, tipo JavaScript).
# Si lo dejas vacío se usa DEMO_MAP_ID, válido solo para desarrollo.
VITE_GOOGLE_MAPS_MAP_ID=

# Supabase: mismo proyecto que la app Aeroservice (Project Settings > API).
# Usa la clave pública (publishable/anon). NUNCA la service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Roles de profiles.rol que pueden ingresar al portal de reportes (separados por coma).
VITE_PORTAL_ROLES=administrador,administrador_visualizador
